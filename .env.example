# Copy to .env for an explicitly authorized real API run. Never commit .env.
# Offline tests use the fake provider and require no key.

SLAM_MODEL_PROVIDER=fake
SLAM_MODEL=fake-structured-v1
SLAM_API_TIMEOUT_SECONDS=60
SLAM_API_MAX_RETRIES=2
SLAM_API_MAX_CONCURRENCY=4

# Zero disables paid API calls by default. Set a positive ceiling deliberately.
SLAM_API_BUDGET_USD=0

# Required only when SLAM_MODEL_PROVIDER=openai.
OPENAI_API_KEY=

# --- Groq (OpenAI-compatible) with ordered key failover ---------------------------------------
# Optional. Keys are tried in the order listed: the first usable one is kept until it is rejected
# (401/403) or runs out (429), then the next takes over. Separate keys with commas.
# Groq applies rate limits per organization, so extra keys add capacity only when they belong to
# different organizations; they always help against a revoked or mistyped key.
# With Docker Compose do NOT set SLAM_MODEL_PROVIDER / SLAM_MODEL in this file: Compose copies both
# into every container, including the default offline test run. Pass them for the real run:
#   docker compose run --rm -e SLAM_MODEL_PROVIDER=groq -e SLAM_MODEL=<model id> slam-dev #     python code/main.py --check-keys
# GROQ_API_KEYS=
# SLAM_API_MAX_CALLS=120  # required: exact ceiling on attempted calls
# SLAM_API_MAX_TOKENS=0   # optional ceiling on input+output tokens (0 = off)
# SLAM_API_MAX_OUTPUT_TOKENS=4096
# SLAM_PRICE_INPUT_PER_MTOK_USD=0   # only used to estimate cost; 0 = free tier or unpriced
# SLAM_PRICE_OUTPUT_PER_MTOK_USD=0
